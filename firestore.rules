rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Vehicle catalogue is written only by trusted server environments.
    // Public reads will be enabled only for validated published records.
    match /vehicles/{vehicleId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
